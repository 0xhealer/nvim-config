# Set default behavior: auto-detect text files and normalize line endings to LF
* text=auto

# Enforce LF (Linux/Mac) line endings for source code files
*.js text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.lua text eol=lf
*.kdl text eol=lf
*.md text eol=lf

# Enforce CRLF (Windows) line endings for batch scripts
*.bat text eol=crlf

# Treat media & archives as binary files (prevents corrupting them during git checkout)
*.png binary
*.jpg binary
*.zip binary

# Exclude internal files from generated zip downloads (e.g., via GitHub/GitLab "Download ZIP")
.gitignore export-ignore
.gitattributes export-ignore